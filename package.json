{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "tsc --noEmit",
    "check:search": "python3 scripts/check-search.py",
    "check:search:live": "python3 scripts/check-search.py --live",
    "check:editorial": "node scripts/blog-editorial.mjs check",
    "blog:daily:status": "node scripts/blog-editorial.mjs status",
    "blog:daily:check": "python3 scripts/daily-blog-run.py --check",
    "blog:daily:run": "python3 scripts/daily-blog-run.py",
    "test:daily": "PYTHONDONTWRITEBYTECODE=1 python3 scripts/daily-blog-run.test.py",
    "deploy:plan": "node scripts/publish.mjs --dry-run",
    "deploy": "npm run build && node scripts/publish.mjs",
    "blog:agent:state": "node scripts/blog-agent-state.mjs",
    "blog:check": "node scripts/check-blog-style.mjs",
    "blog:open-approved-pr": "node scripts/open-approved-blog-pr.mjs",
    "blog:submit-draft": "node scripts/submit-blog-draft.mjs",
    "blog:submit-revision": "node scripts/submit-blog-revision.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/rss": "^4.0.15",
    "@astrojs/sitemap": "^3.7.0",
    "astro": "^5.17.1",
    "sharp": "^0.34.3"
  }
}
