---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		<style>
			.article-header {
				max-width: 720px;
				margin: 0 auto;
				padding: 3em 1em 0;
			}
			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 0.25em;
				font-size: 0.9em;
				color: var(--accent);
				text-decoration: none;
				font-weight: 500;
				margin-bottom: 2em;
			}
			.back-link:hover {
				opacity: 0.8;
			}
			.article-title {
				font-size: 2.25em;
				font-weight: 700;
				line-height: 1.2;
				margin-bottom: 0.5em;
				color: rgb(var(--black));
			}
			.article-meta {
				color: rgb(var(--gray));
				font-size: 0.9em;
				margin-bottom: 2em;
			}
			.last-updated {
				font-style: italic;
			}
			.prose {
				max-width: 720px;
				margin: 0 auto;
				padding: 0 1em 4em;
				color: rgb(var(--gray-dark));
			}
			@media (max-width: 720px) {
				.article-title {
					font-size: 1.6em;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="article-header">
					<a href="/blog/" class="back-link">&larr; Back to posts</a>
					<h1 class="article-title">{title}</h1>
					<div class="article-meta">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="last-updated">
									&middot; Updated <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
				</div>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
