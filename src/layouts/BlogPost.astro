---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReadingDefinitions from '../components/ReadingDefinitions.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { categories, categoryPath } from '../lib/blog';
import authors from '../data/authors.json';
type Props = CollectionEntry<'blog'>['data'];
const { title, description, category, author, pubDate, updatedDate, heroImage, heroImageAlt } = Astro.props;
const categoryName = categories.find(({ id }) => id === category)?.title ?? category;
const articleAuthor = authors[author as keyof typeof authors];
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={`${title} · Padho Blog`} description={description} image={heroImage} article={{ headline: title, category: categoryName, author: articleAuthor, publishedTime: pubDate, modifiedTime: updatedDate }} /></head>
  <body>
    <div class="blog-background" aria-hidden="true"></div>
    <Header />
    <main id="main" class="article-page page-width">
      <article class="reading">
        <header class="reading-header">
          <p class="reading-meta"><a href={categoryPath(category)}>{categoryName}</a> <span aria-hidden="true">·</span> <FormattedDate date={pubDate} /> <span aria-hidden="true">·</span> <a href={articleAuthor.url} rel="author">{articleAuthor.name}</a></p>
          <h1>{title}</h1>
          <p class="reading-lede">{description}</p>
          <Image class="reading-image" src={heroImage} alt={heroImageAlt} widths={[480, 800, 1440]} sizes="(max-width: 767px) 100vw, 720px" loading="eager" fetchpriority="high" />
        </header>
        <div class="prose"><slot /></div>
      </article>
    </main>
    <ReadingDefinitions />
    <Footer />
  </body>
</html>
