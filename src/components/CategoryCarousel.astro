---
import CategoryCard from './CategoryCard.astro';
import { categories } from '../lib/blog';
import arrow from '../assets/arrow-right.svg?url';
---
<div class="category-carousel" data-category-carousel>
  <div class="category-grid" id="blog-categories" role="region" aria-label="Blog categories" tabindex="0">
    {categories.map((category) => <CategoryCard category={category} />)}
  </div>
  <div class="category-carousel__controls" hidden>
    <button class="button secondary blog-button category-carousel__previous" type="button" aria-label="Previous category" aria-controls="blog-categories" disabled><img src={arrow} width="20" height="20" alt="" /></button>
    <span class="category-carousel__position" aria-live="polite" aria-atomic="true">1 / {categories.length}</span>
    <button class="button secondary blog-button category-carousel__next" type="button" aria-label="Next category" aria-controls="blog-categories"><img src={arrow} width="20" height="20" alt="" /></button>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-category-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('.category-grid')!;
    const cards = Array.from(track.querySelectorAll<HTMLElement>('.category-card'));
    const controls = carousel.querySelector<HTMLElement>('.category-carousel__controls')!;
    const previous = controls.querySelector<HTMLButtonElement>('.category-carousel__previous')!;
    const next = controls.querySelector<HTMLButtonElement>('.category-carousel__next')!;
    const position = controls.querySelector<HTMLElement>('.category-carousel__position')!;
    const mobile = matchMedia('(max-width: 767px)');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let index = 0;
    const nearest = () => cards.reduce((best, card, current) => {
      const distance = Math.abs(card.offsetLeft - cards[0].offsetLeft - track.scrollLeft);
      const bestDistance = Math.abs(cards[best].offsetLeft - cards[0].offsetLeft - track.scrollLeft);
      return distance < bestDistance ? current : best;
    }, 0);
    const update = () => {
      controls.hidden = !mobile.matches;
      track.tabIndex = mobile.matches ? 0 : -1;
      index = nearest();
      previous.disabled = index === 0;
      next.disabled = index === cards.length - 1;
      const label = `${index + 1} / ${cards.length}`;
      if (position.textContent !== label) position.textContent = label;
    };
    const move = (step: number) => {
      const target = Math.min(cards.length - 1, Math.max(0, index + step));
      track.scrollTo({ left: cards[target].offsetLeft - cards[0].offsetLeft, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
    };
    previous.addEventListener('click', () => move(-1));
    next.addEventListener('click', () => move(1));
    track.addEventListener('scroll', update, { passive: true });
    track.addEventListener('keydown', (event) => {
      if (!mobile.matches || event.target !== track || !['ArrowLeft', 'ArrowRight'].includes(event.key)) return;
      event.preventDefault();
      move(event.key === 'ArrowRight' ? 1 : -1);
    });
    mobile.addEventListener('change', update);
    new ResizeObserver(update).observe(track);
    update();
  });
</script>
