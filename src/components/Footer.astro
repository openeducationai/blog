---
const today = new Date();
---

<footer>
	<div class="footer-content">
		<p>&copy; {today.getFullYear()} PadhoAI. All rights reserved.</p>
		<p class="tagline">AI-powered adaptive learning for everyone.</p>
	</div>
</footer>
<style>
	footer {
		padding: 3em 1em;
		border-top: 1px solid rgba(var(--gray-light), 1);
		color: rgb(var(--gray));
		text-align: center;
	}
	.footer-content {
		max-width: 960px;
		margin: 0 auto;
	}
	p {
		margin: 0;
	}
	.tagline {
		font-size: 0.85em;
		margin-top: 0.25em;
	}
</style>
