---
const today = new Date();
---

<footer>
	<div class="footer-content">
		<p>&copy; {today.getFullYear()} PadhoAI. All rights reserved.</p>
		<p class="tagline">AI-powered adaptive learning for everyone.</p>
	</div>
</footer>
<style>
	footer {
		padding: 3em 1em;
		border-top: 2px solid var(--orange);
		background: linear-gradient(180deg, rgba(232, 93, 4, 0.06) 0%, rgba(108, 63, 226, 0.04) 40%, transparent 100%);
		color: rgb(var(--gray));
		text-align: center;
	}
	.footer-content {
		max-width: 960px;
		margin: 0 auto;
	}
	p {
		margin: 0;
	}
	.tagline {
		font-size: 0.9em;
		margin-top: 0.35em;
		background: var(--gradient-accent);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		font-weight: 600;
	}
</style>
