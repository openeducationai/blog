---
import capacitorConnections from '../../assets/articles/capacitor-connections.svg?raw';
import capacitorLayers from '../../assets/articles/capacitor-layers.svg?raw';
import osmoticParticles from '../../assets/articles/osmotic-particles.svg?raw';
import varianceShift from '../../assets/articles/variance-shift.svg?raw';
import fieldEnergy from '../../assets/articles/field-energy-dimensions.svg?raw';
import buffer from '../../assets/articles/buffer-neutralisation.svg?raw';
import binomial from '../../assets/articles/binomial-choice.svg?raw';
import gravity from '../../assets/articles/gravity-height-depth.svg?raw';
import moles from '../../assets/articles/mass-to-moles.svg?raw';
import positive from '../../assets/articles/quadratic-positive.svg?raw';
import seriesVoltmeter from '../../assets/articles/series-voltmeter.svg?raw';
import bohrRadius from '../../assets/articles/bohr-radius.svg?raw';
import circleChord from '../../assets/articles/circle-chord.svg?raw';
import emDirections from '../../assets/articles/em-field-directions.svg?raw';
import heatWorkCycle from '../../assets/articles/heat-work-cycle.svg?raw';
import nestedSums from '../../assets/articles/nested-sum-steps.svg?raw';
import matterWave from '../../assets/articles/matter-wave-momentum.svg?raw';
import oxygenAntibonding from '../../assets/articles/oxygen-antibonding.svg?raw';
import linearConsistency from '../../assets/articles/linear-system-consistency.svg?raw';
import gravityEnergy from '../../assets/articles/gravitational-energy-distance.svg?raw';
import nernstReaction from '../../assets/articles/nernst-reaction-quotient.svg?raw';
import arithmeticSums from '../../assets/articles/arithmetic-running-sums.svg?raw';
import measurementError from '../../assets/articles/measurement-error-budget.svg?raw';
import gasEquilibrium from '../../assets/articles/gas-equilibrium-amounts.svg?raw';
import bayesPaths from '../../assets/articles/bayes-visible-pairs.svg?raw';
import surfaceArea from '../../assets/articles/drop-surface-area.svg?raw';
import tetrahedralEnergy from '../../assets/articles/tetrahedral-energy-levels.svg?raw';
import inverseOrder from '../../assets/articles/matrix-inverse-order.svg?raw';
import loopTorque from '../../assets/articles/current-loop-normal.svg?raw';
import equilibriumRewrite from '../../assets/articles/equilibrium-reaction-steps.svg?raw';
import geometricEquations from '../../assets/articles/geometric-pair-sums.svg?raw';
import shmPhase from '../../assets/articles/shm-phase-clock.svg?raw';
import orbitalNodes from '../../assets/articles/orbital-node-types.svg?raw';
import joinSlopes from '../../assets/articles/slopes-at-a-join.svg?raw';
interface Props { kind: 'connections' | 'layers' | 'particles' | 'spread' | 'fieldEnergy' | 'buffer' | 'binomial' | 'gravity' | 'moles' | 'positive' | 'seriesVoltmeter' | 'bohrRadius' | 'circleChord' | 'emDirections' | 'heatWorkCycle' | 'nestedSums' | 'matterWave' | 'oxygenAntibonding' | 'linearConsistency' | 'gravityEnergy' | 'nernstReaction' | 'arithmeticSums' | 'measurementError' | 'gasEquilibrium' | 'bayesPaths' | 'surfaceArea' | 'tetrahedralEnergy' | 'inverseOrder' | 'loopTorque' | 'equilibriumRewrite' | 'geometricEquations' | 'shmPhase' | 'orbitalNodes' | 'joinSlopes' }
const { kind } = Astro.props;
const diagrams = { connections: capacitorConnections, layers: capacitorLayers, particles: osmoticParticles, spread: varianceShift, fieldEnergy, buffer, binomial, gravity, moles, positive, seriesVoltmeter, bohrRadius, circleChord, emDirections, heatWorkCycle, nestedSums, matterWave, oxygenAntibonding, linearConsistency, gravityEnergy, nernstReaction, arithmeticSums, measurementError, gasEquilibrium, bayesPaths, surfaceArea, tetrahedralEnergy, inverseOrder, loopTorque, equilibriumRewrite, geometricEquations, shmPhase, orbitalNodes, joinSlopes };
---
<figure class="article-diagram" aria-labelledby={`diagram-${kind}-caption`}>
  <div class="diagram-drawing" set:html={diagrams[kind]} />
  <figcaption id={`diagram-${kind}-caption`}><slot /></figcaption>
</figure>
<style>
  .article-diagram { display: grid; gap: calc(var(--spacing) * 4); padding: calc(var(--spacing) * 4); background: var(--color-surface); border: var(--stroke-default) solid var(--color-border); border-radius: var(--radius-card); }
  .diagram-drawing { width: 100%; }
  .diagram-drawing :global(svg) { display: block; width: 100%; height: auto; }
</style>
