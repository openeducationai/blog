---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<div class="nav-left">
			<a href="/blog/" class="logo">
				<img src="/blog/padhoai.svg" alt="PadhoAI" class="logo-icon" width="28" height="27" />
				<span class="logo-padho">Padho</span><span class="logo-ai">AI</span>
				<span class="logo-divider">/</span>
				<span class="logo-blog">Blog</span>
			</a>
		</div>
		<div class="internal-links">
			<HeaderLink href="/blog/">Posts</HeaderLink>
			<HeaderLink href="/blog/about/">About</HeaderLink>
			<a href="/" class="back-to-app">Back to App</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 2em;
		background: white;
		border-bottom: 1px solid rgba(var(--gray-light), 1);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 960px;
		margin: 0 auto;
		height: 64px;
	}
	.logo {
		text-decoration: none;
		font-size: 1.2em;
		font-weight: 700;
		display: flex;
		align-items: center;
		gap: 0.15em;
	}
	.logo-padho {
		color: rgb(var(--black));
	}
	.logo-icon {
		width: 28px;
		height: 27px;
		margin-right: 0.25em;
	}
	.logo-ai {
		color: var(--accent);
	}
	.logo-divider {
		color: rgb(var(--gray));
		font-weight: 400;
		margin: 0 0.2em;
	}
	.logo-blog {
		color: rgb(var(--gray));
		font-weight: 500;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25em;
	}
	.internal-links a {
		padding: 0.5em 0.75em;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 0.95em;
		font-weight: 500;
		border-radius: 6px;
		transition: background 0.15s ease;
	}
	.internal-links a:hover {
		background: rgba(var(--gray-light), 0.5);
		color: rgb(var(--black));
	}
	.back-to-app {
		color: var(--accent) !important;
		font-weight: 600 !important;
	}
	@media (max-width: 720px) {
		header {
			padding: 0 1em;
		}
		.logo {
			font-size: 1em;
		}
	}
</style>
