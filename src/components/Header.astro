---
import brand from '../assets/site/brand.svg?url';
import menu from '../assets/site/menu.svg?url';
---
<a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header wrap" id="top">
    <nav class="masthead" aria-label="Main navigation">
      <a class="brand" href="https://padho.ai/" aria-label="Padho.ai home"><img src={brand} width="40" height="40" alt="">padho.ai</a>
      <div class="desktop-nav">
        <a href="https://padho.ai/pricing" data-marketing-cta-placement="learn">Pricing</a><a href="https://padho.ai/schools">For Schools</a><a href="https://padho.ai/blog">Blog</a><a href="https://padho.ai/support">Support</a>
      </div>
      <div class="nav-actions">
        <a class="button primary login-button" href="https://learn.padho.ai/login" data-app-path="/login" data-marketing-cta-placement="header">Log in</a>
        <button class="menu-button" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav" hidden><img src={menu} width="24" height="24" alt=""></button>
      </div>
    </nav>
    <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation" hidden>
      <a href="https://padho.ai/pricing" data-marketing-cta-placement="learn">Pricing</a><a href="https://padho.ai/schools">For Schools</a><a href="https://padho.ai/blog">Blog</a><a href="https://padho.ai/support">Support</a>
    </nav>
    <noscript><style is:inline>@media(max-width:1023px){.desktop-nav{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 20px;width:100%;order:3}.masthead{flex-wrap:wrap;border-radius:24px;height:auto;padding:12px 16px;gap:12px}.site-header{position:relative}}</style></noscript>
  </header>
<script>import '../scripts/site.js';</script>
