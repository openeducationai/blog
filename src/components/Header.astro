---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<div class="nav-left">
			<a href="/blog/" class="logo">
				<img
					src="https://res.cloudinary.com/ddgqbftjb/image/upload/v1755692594/padho-ai-logo_rsglwb.jpg"
					alt="Padho.ai"
					class="logo-img"
					width="120"
					height="40"
				/>
				<span class="logo-divider">/</span>
				<span class="logo-blog">Blog</span>
			</a>
		</div>
		<div class="internal-links">
			<HeaderLink href="/blog/">Posts</HeaderLink>
			<HeaderLink href="/blog/about/">About</HeaderLink>
			<a href="/" class="back-to-app">Back to App</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 2em;
		background: #fff;
		border-bottom: 2px solid var(--accent);
		box-shadow: 0 4px 0 -2px var(--orange), 0 6px 16px rgba(108, 63, 226, 0.08);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 960px;
		margin: 0 auto;
		height: 64px;
	}
	.logo {
		text-decoration: none;
		font-size: 1.2em;
		font-weight: 700;
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.logo-img {
		height: 36px;
		width: auto;
		display: block;
		object-fit: contain;
	}
	.logo-divider {
		color: rgb(var(--gray));
		font-weight: 400;
		margin: 0 0.2em;
	}
	.logo-blog {
		color: var(--orange);
		font-weight: 600;
	}
	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25em;
	}
	.internal-links a {
		padding: 0.5em 0.75em;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 0.95em;
		font-weight: 500;
		border-radius: 6px;
		transition: background 0.15s ease;
	}
	.internal-links a:hover {
		background: var(--orange-pale);
		color: var(--orange);
	}
	.back-to-app {
		color: var(--accent) !important;
		font-weight: 600 !important;
	}
	.back-to-app:hover {
		color: var(--orange) !important;
	}
	@media (max-width: 720px) {
		header {
			padding: 0 1em;
		}
		.logo {
			font-size: 1em;
		}
		.logo-img {
			height: 28px;
		}
	}
</style>
