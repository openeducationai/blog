---
import '../styles/global.css';
import BlogAnalytics from './BlogAnalytics.astro';
import type { ImageMetadata } from 'astro';
import interFont from '../assets/fonts/inter-100-900.woff2?url';
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  noindex?: boolean;
  article?: {
    headline: string;
    category: string;
    author: { type: string; name: string; url: string };
    publishedTime: Date;
    modifiedTime?: Date;
  };
}
const { title, description, image, article, noindex = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const articleSchema = article && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${canonicalURL.href}#article`,
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
  url: canonicalURL.href,
  headline: article.headline,
  description,
  inLanguage: 'en',
  articleSection: article.category,
  datePublished: article.publishedTime.toISOString(),
  ...(article.modifiedTime && { dateModified: article.modifiedTime.toISOString() }),
  ...(image && { image: [new URL(image.src, Astro.site).href] }),
  author: { '@type': article.author.type, name: article.author.name, url: article.author.url },
  publisher: { '@type': 'Organization', name: 'Padho', url: new URL('/', Astro.site).href },
};
---
<meta charset="utf-8" />
<script is:inline>if (/Android/i.test(navigator.userAgent)) document.documentElement.dataset.platform = "android";</script>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/blog/favicon.svg" />
<link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
<link rel="sitemap" href="/blog/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/blog/rss.xml" />
<link rel="canonical" href={canonicalURL} />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex' : 'max-image-preview:large'} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
{image && <meta property="og:image" content={new URL(image.src, Astro.site)} />}
{article && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
{article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema).replace(/</g, '\\u003c')} />}

<BlogAnalytics title={article?.headline ?? title} category={article?.category} isArticle={!!article} noindex={noindex} />
