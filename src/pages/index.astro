---
import Page from '../layouts/Page.astro';
import CategoryCarousel from '../components/CategoryCarousel.astro';
import RecentArticles from '../components/RecentArticles.astro';
import { getPublishedPosts } from '../lib/blog';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
const posts = await getPublishedPosts();
---
<Page title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <div class="blog-home page-width">
    <h1>Blog</h1>
    <CategoryCarousel />
    <RecentArticles posts={posts} />
  </div>
</Page>
