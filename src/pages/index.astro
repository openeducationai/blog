---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				max-width: 960px;
				margin: 0 auto;
				padding: 4em 1em 2em;
			}
			.hero-title {
				font-size: 2.5em;
				font-weight: 700;
				margin-bottom: 0.25em;
				color: rgb(var(--black));
			}
			.hero-subtitle {
				font-size: 1.15em;
				color: rgb(var(--gray));
				margin-bottom: 3em;
				max-width: 600px;
			}
			.featured {
				max-width: 960px;
				margin: 0 auto;
				padding: 0 1em 3em;
			}
			.featured a {
				text-decoration: none;
				display: block;
				border-radius: 16px;
				overflow: hidden;
				border: 1px solid rgba(var(--gray-light), 1);
				transition: box-shadow 0.2s ease, transform 0.2s ease;
			}
			.featured a:hover {
				box-shadow: 0 8px 32px rgba(var(--gray), 20%);
				transform: translateY(-2px);
			}
			.featured-content {
				padding: 2em 2.5em;
			}
			.featured-label {
				font-size: 0.8em;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				color: var(--accent);
				margin-bottom: 0.75em;
			}
			.featured-title {
				font-size: 1.75em;
				font-weight: 700;
				color: rgb(var(--black));
				margin-bottom: 0.5em;
				line-height: 1.3;
			}
			.featured-desc {
				color: rgb(var(--gray));
				margin-bottom: 1em;
				line-height: 1.6;
			}
			.featured-date {
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.posts-section {
				max-width: 960px;
				margin: 0 auto;
				padding: 0 1em 4em;
			}
			.section-title {
				font-size: 1.3em;
				font-weight: 600;
				margin-bottom: 1.5em;
				color: rgb(var(--black));
			}
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.5em;
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.posts-grid li a {
				display: block;
				text-decoration: none;
				padding: 1.5em;
				border-radius: 12px;
				border: 1px solid rgba(var(--gray-light), 1);
				transition: box-shadow 0.2s ease, transform 0.2s ease;
				height: 100%;
				box-sizing: border-box;
			}
			.posts-grid li a:hover {
				box-shadow: 0 4px 16px rgba(var(--gray), 15%);
				transform: translateY(-1px);
			}
			.post-title {
				font-size: 1.15em;
				font-weight: 600;
				color: rgb(var(--black));
				margin-bottom: 0.5em;
				line-height: 1.3;
			}
			.post-desc {
				color: rgb(var(--gray));
				font-size: 0.9em;
				margin-bottom: 0.75em;
				line-height: 1.5;
			}
			.post-date {
				color: rgb(var(--gray));
				font-size: 0.85em;
			}
			@media (max-width: 720px) {
				.hero-title {
					font-size: 1.75em;
				}
				.hero-subtitle {
					font-size: 1em;
				}
				.featured-content {
					padding: 1.5em;
				}
				.featured-title {
					font-size: 1.3em;
				}
				.posts-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="hero">
			<h1 class="hero-title">PadhoAI Blog</h1>
			<p class="hero-subtitle">Insights on AI-powered education, adaptive learning, and building the future of personalized teaching.</p>
		</div>

		{featuredPost && (
			<div class="featured">
				<a href={`/blog/${featuredPost.id}/`}>
					<div class="featured-content">
						<div class="featured-label">Latest</div>
						<h2 class="featured-title">{featuredPost.data.title}</h2>
						<p class="featured-desc">{featuredPost.data.description}</p>
						<p class="featured-date"><FormattedDate date={featuredPost.data.pubDate} /></p>
					</div>
				</a>
			</div>
		)}

		{remainingPosts.length > 0 && (
			<div class="posts-section">
				<h2 class="section-title">All Posts</h2>
				<ul class="posts-grid">
					{remainingPosts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<h3 class="post-title">{post.data.title}</h3>
								<p class="post-desc">{post.data.description}</p>
								<p class="post-date"><FormattedDate date={post.data.pubDate} /></p>
							</a>
						</li>
					))}
				</ul>
			</div>
		)}

		<Footer />
	</body>
</html>
