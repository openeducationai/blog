---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

/** Strip Markdown links [text](url) to plain text so descriptions display cleanly (card is already a link). */
function descriptionToPlainText(desc: string): string {
	return desc.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');
}

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const featuredPost = posts[0];
const remainingPosts = posts.slice(1);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				max-width: 960px;
				margin: 0 auto;
				padding: 4em 1em 2em;
			}
			.hero-title-wrap {
				margin-bottom: 0.5em;
			}
			.hero-title {
				font-size: 2.5em;
				font-weight: 700;
				margin-bottom: 0;
				background: var(--gradient-accent);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}
			.hero-accent {
				display: inline-block;
				height: 4px;
				width: 80px;
				background: var(--gradient-accent);
				border-radius: 2px;
				margin-top: 0.5em;
			}
			.hero-subtitle {
				font-size: 1.15em;
				color: rgb(var(--gray));
				margin-bottom: 3em;
				max-width: 600px;
			}
			.featured {
				max-width: 960px;
				margin: 0 auto;
				padding: 0 1em 3em;
			}
			.featured a {
				text-decoration: none;
				display: block;
				border-radius: 16px;
				overflow: hidden;
				border: 2px solid rgba(var(--gray-light), 1);
				border-left: 4px solid var(--orange);
				background: #fff;
				transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
			}
			.featured a:hover {
				border-color: rgba(var(--gray-light), 1);
				border-left-color: var(--orange);
				box-shadow: var(--box-shadow-orange);
				transform: translateY(-2px);
			}
			.featured-content {
				padding: 2em 2.5em;
			}
			.featured-label {
				display: inline-block;
				font-size: 0.75em;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: var(--orange);
				background: var(--orange-pale);
				padding: 0.35em 0.75em;
				border-radius: 999px;
				margin-bottom: 0.75em;
			}
			.featured-title {
				font-size: 1.75em;
				font-weight: 700;
				color: rgb(var(--black));
				margin-bottom: 0.5em;
				line-height: 1.3;
			}
			.featured-desc {
				color: rgb(var(--gray));
				margin-bottom: 1em;
				line-height: 1.6;
			}
			.featured-date {
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.posts-section {
				max-width: 960px;
				margin: 0 auto;
				padding: 0 1em 4em;
			}
			.section-title {
				font-size: 1.3em;
				font-weight: 600;
				margin-bottom: 1.5em;
				color: rgb(var(--black));
				display: flex;
				align-items: center;
				gap: 0.5em;
			}
			.section-title::before {
				content: '';
				display: inline-block;
				width: 4px;
				height: 1.2em;
				background: var(--orange);
				border-radius: 2px;
			}
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.5em;
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.posts-grid li a {
				display: block;
				text-decoration: none;
				padding: 1.5em;
				border-radius: 12px;
				border: 1px solid rgba(var(--gray-light), 1);
				border-left: 3px solid transparent;
				background: #fff;
				transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
				height: 100%;
				box-sizing: border-box;
			}
			.posts-grid li a:hover {
				border-left-color: var(--orange);
				border-color: rgba(232, 93, 4, 0.25);
				box-shadow: var(--box-shadow-orange);
				transform: translateY(-1px);
			}
			.post-title {
				font-size: 1.15em;
				font-weight: 600;
				color: rgb(var(--black));
				margin-bottom: 0.5em;
				line-height: 1.3;
				transition: color 0.2s ease;
			}
			.posts-grid li a:hover .post-title {
				color: var(--orange);
			}
			.post-desc {
				color: rgb(var(--gray));
				font-size: 0.9em;
				margin-bottom: 0.75em;
				line-height: 1.5;
			}
			.post-date {
				color: rgb(var(--gray));
				font-size: 0.85em;
			}
			@media (max-width: 720px) {
				.hero-title {
					font-size: 1.75em;
				}
				.hero-subtitle {
					font-size: 1em;
				}
				.featured-content {
					padding: 1.5em;
				}
				.featured-title {
					font-size: 1.3em;
				}
				.posts-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="hero">
			<div class="hero-title-wrap">
				<h1 class="hero-title">The padho.ai blog</h1>
				<span class="hero-accent" aria-hidden="true"></span>
			</div>
			<p class="hero-subtitle">
				Insights on AI-powered education, adaptive learning, and building the future of personalized teaching.
			</p>
		</div>

		{featuredPost && (
			<div class="featured">
				<a href={`/blog/${featuredPost.id}/`}>
					<div class="featured-content">
						<div class="featured-label">Latest</div>
						<h2 class="featured-title">{featuredPost.data.title}</h2>
						<p class="featured-desc">{descriptionToPlainText(featuredPost.data.description)}</p>
						<p class="featured-date"><FormattedDate date={featuredPost.data.pubDate} /></p>
					</div>
				</a>
			</div>
		)}

		{remainingPosts.length > 0 && (
			<div class="posts-section">
				<h2 class="section-title">All posts</h2>
				<ul class="posts-grid">
					{remainingPosts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<h3 class="post-title">{post.data.title}</h3>
								<p class="post-desc">{descriptionToPlainText(post.data.description)}</p>
								<p class="post-date"><FormattedDate date={post.data.pubDate} /></p>
							</a>
						</li>
					))}
				</ul>
			</div>
		)}

		<Footer />
	</body>
</html>
